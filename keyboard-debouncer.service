[Unit]
Description=Keyboard Debouncer — evdev chatter filter
After=local-fs.target
# Note: Built-in reconnection loop handles hotplugging; no settle service needed.

[Service]
Type=simple
ExecStart=/usr/local/bin/keyboard-debouncer --config /etc/debouncer.conf

# ── Privilege model ────────────────────────────────────────────────────────────
# Run as a dedicated system user in the input group for /dev/input/event*
# and /dev/uinput access.
User=kbd-debouncer
Group=input

# ── State & runtime directories ───────────────────────────────────────────────
# Creates /var/lib/keyboard-debouncer/ (health-tracker DB) and
# /run/keyboard-debouncer/ (live watch socket) owned by kbd-debouncer.
# Restricted to 0700 with UMask 0077 so keylog data and live events are only
# accessible by the service user and root.
StateDirectory=keyboard-debouncer
StateDirectoryMode=0700
RuntimeDirectory=keyboard-debouncer
RuntimeDirectoryMode=0700
UMask=0077

# ── Restart policy ────────────────────────────────────────────────────────────
# Restart on failure (e.g. fatal config error after a config change).
# The daemon's internal loop already handles normal disconnects, so crashes
# are the only case where systemd needs to intervene.
Restart=on-failure
RestartSec=2s

# ── Logging ───────────────────────────────────────────────────────────────────
StandardOutput=journal
StandardError=journal

# ── Sandbox & Hardening ───────────────────────────────────────────────────────
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
# Start automatically at boot in multi-user (non-graphical) and graphical targets.
WantedBy=multi-user.target

