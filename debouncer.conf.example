# Keyboard debouncer configuration
# Copy this file to debouncer.conf and fill in your values.
# Run `evtest` to find your keyboard name and the KEY_* names of keys to debounce.

# Physical keyboard name as reported by the kernel (from evtest or /sys/class/input).
# Used to automatically find the /dev/input/eventX node on each boot.
# Required unless DEVICE_PATH is set.
KEYBOARD_NAME=your-keyboard-name-in-evtest

# Direct path to the event device node. Overrides KEYBOARD_NAME if both are set.
# Useful when the event number is stable (e.g. a USB keyboard always on event10).
# Uncomment and set if you prefer to skip the name-based lookup.
# DEVICE_PATH=/dev/input/event10

# Keys to debounce — comma-separated, using KEY_* names exactly as shown by evtest.
# REQUIRED: the program refuses to start without this.
# Example: KEYS=KEY_K,KEY_L,KEY_ENTER
KEYS=KEY_K,KEY_L
# Debounce all keys instead of just the KEYS list.
# Default: false. When set to true, all keys are debounced except modifier/control keys.
# Modifier keys excluded: Shift, Ctrl, Alt, Meta, CapsLock, NumLock, ScrollLock, Fn.
# If both KEYS and DEBOUNCE_ALL_KEYS are set, all keys are debounced (KEYS becomes informational).
# DEBOUNCE_ALL_KEYS=false
# Debounce window in milliseconds.
# Default: 30. Any re-press within this window after the last release is suppressed.
THRESHOLD_MS=30

# Short hold duration threshold in milliseconds.
# Default: 70. A hold below this (but above MICRO_HOLD_THRESHOLD_MS) arms the extended
# debounce window. Raised to 70 ms to also catch medium bounces (59–63 ms observed in
# hardware data) which fall above the old 40–50 ms threshold.
SHORT_HOLD_THRESHOLD_MS=70

# Extended debounce window in milliseconds.
# Default: 100. Used after a short hold. Covers the 67–100 ms bounce gaps that follow
# partial-contact presses.
EXTENDED_THRESHOLD_MS=100

# Micro hold duration threshold in milliseconds.
# Default: 20. A hold below this is classified as hardware ghost contact — no human
# intentionally holds a key for less than 20 ms. Arms the micro-extended window.
MICRO_HOLD_THRESHOLD_MS=20

# Micro-extended debounce window in milliseconds.
# Default: 150. Used after a micro hold. Covers the 79–99 ms bounce gaps that follow
# 3–11 ms ghost contacts. Safe for double-letter typing ("ee", "oo") since conscious
# same-key re-strikes at 120 WPM are typically 160–220 ms.
MICRO_EXTENDED_THRESHOLD_MS=150

# Set to true to log every forwarded event immediately.
# Default: false (forwarded events are only shown when followed by a suppressed one, for context).
LOG_FORWARD=false

# Enable key health tracking by setting a path to an SQLite database.
# When set, the debouncer passively records every keypress (including non-target keys)
# to help identify defective hardware before you know to debounce it.
# Data stays local. Ensure you restrict file permissions appropriately (e.g. chmod 600).
# Example: TRACK_DB=/var/lib/keyboard-debouncer/keys.db
# TRACK_DB=/var/lib/keyboard-debouncer/keys.db
